{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Student Cloud app",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"student-cloud/backend",
				"start"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run Local Student Portal",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"student-cloud/backend",
				"start"
			],
			"options": {
				"env": {
					"DB_DRIVER": "sqlite",
					"NODE_ENV": "development",
					"PORT": "5002",
					"APP_BASE_URL": "http://localhost:5002"
				}
			},
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Install Student Cloud dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"student-cloud/backend",
